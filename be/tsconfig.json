{
  "compilerOptions": {
    "target":                   "ES2020",
    "module":                   "commonjs",
    "lib":                      ["ES2020"],
    "outDir":                   "./dist",
    "rootDir":                  "./src",
    "strict":                   true,
    "esModuleInterop":          true,
    "skipLibCheck":             true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule":        true,

    // Bắt buộc cho TypeORM decorator
    "experimentalDecorators":   true,
    "emitDecoratorMetadata":    true,

    // Cho phép class property không khởi tạo trong constructor
    // (TypeORM Entity dùng pattern này)
    "strictPropertyInitialization": false,

    // Path alias (tuỳ chọn — dùng tsconfig-paths khi chạy)
    "baseUrl":       ".",          
    "paths": {
      "@/*": ["src/*"],
      "@config/*":     ["src/config/*"],
      "@models/*":     ["src/models/*"],
      "@controllers/*":["src/controllers/*"],
      "@services/*":   ["src/services/*"],
      "@routes/*":     ["src/routes/*"],
      "@middlewares/*":["src/middlewares/*"],
      "@utils/*":      ["src/utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
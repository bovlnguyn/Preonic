# ╔═══════════════════════════════════════════════════════════╗
# ║           PREOONIC BACKEND - ENVIRONMENT CONFIG           ║
# ║               Copy this file to .env and fill             ║
# ║                                                           ║
# ║  🟢 Required : Bắt buộc phải có để chạy project          ║
# ║  🟡 Optional : Không bắt buộc, có thể để sau             ║
# ║  🔵 Future   : Cho tính năng tương lai                   ║
# ╚═══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# 🟢 SERVER
# ═══════════════════════════════════════════════════════════
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# ═══════════════════════════════════════════════════════════
# 🟢 SQL SERVER ()
# ═══════════════════════════════════════════════════════════
# Database
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=preonic
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# Đặt true nếu kết nối Azure SQL hoặc SQL Server dùng SSL
DB_ENCRYPT=false

# Đặt true khi dùng self-signed certificate (môi trường local/dev)
DB_TRUST_SERVER_CERTIFICATE=true

# TypeORM tự đồng bộ schema (chỉ dùng development — production dùng migration)
DB_SYNCHRONIZE=false

# Bật log query SQL khi debug (development only)
DB_LOGGING=false

# ═══════════════════════════════════════════════════════════
# 🟢 JWT
# ═══════════════════════════════════════════════════════════
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_SECRET_KEY
JWT_REFRESH_EXPIRE=30d

# ═══════════════════════════════════════════════════════════
# 🟢 SECURITY (khớp với logic trong User entity)
# ═══════════════════════════════════════════════════════════
PASSWORD_RESET_EXPIRE=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ═══════════════════════════════════════════════════════════
# 🟢 CORS
# ═══════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:3000
# Thêm nhiều URL nếu cần (preview Vercel, staging...)
# FRONTEND_URLS=https://preview-1.vercel.app,https://preview-2.vercel.app

# ═══════════════════════════════════════════════════════════
# 🟡 EMAIL (SMTP) — cần cho forgot password, verify email
# ═══════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=PreOnic Platform
# SMTP_FROM_EMAIL=noreply@preoonic.com

# ═══════════════════════════════════════════════════════════
# 🟢 FILE UPLOAD (Cloudinary) — bắt buộc để upload ảnh SP/avatar/dispute
# Lấy tại: https://console.cloudinary.com/ → Dashboard
# ═══════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# MAX_FILE_SIZE=5242880
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ═══════════════════════════════════════════════════════════
# 🔵 WEATHER API
# ═══════════════════════════════════════════════════════════
# WEATHER_API_KEY=

# ═══════════════════════════════════════════════════════════
# 🔵 PAYMENT — SePay (chuyển khoản tự động + webhook)
# Lấy tại: https://sepay.vn → liên kết tài khoản ngân hàng → Cấu hình webhook
# Chưa cấu hình thì nút "Tạo lệnh SePay" sẽ báo lỗi rõ ràng thay vì âm thầm không hoạt động.
# ═══════════════════════════════════════════════════════════
# Số tài khoản ngân hàng đã liên kết với SePay
# SEPAY_BANK_ACCOUNT_NUMBER=
# Mã ngân hàng ngắn theo chuẩn SePay/VietQR, vd: MBBank, ACB, Vietcombank...
# SEPAY_BANK_CODE=
# Tên chủ tài khoản (in hoa, không dấu)
# SEPAY_ACCOUNT_HOLDER=
# API Key cấu hình trong SePay dashboard, dùng để xác thực webhook gọi vào server
# SEPAY_WEBHOOK_API_KEY=
# Endpoint tạo ảnh QR chuyển khoản (mặc định SePay), có thể đổi sang VietQR nếu muốn
# SEPAY_QR_BASE_URL=https://qr.sepay.vn/img

# ═══════════════════════════════════════════════════════════
# 🔵 OAUTH
# ═══════════════════════════════════════════════════════════
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ═══════════════════════════════════════════════════════════
# 🔵 BUSINESS SETTINGS
# ═══════════════════════════════════════════════════════════
# PLATFORM_COMMISSION_RATE=3
# CONTRACT_DEPOSIT_PERCENTAGE=20

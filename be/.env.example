# ╔═══════════════════════════════════════════════════════════╗
# ║           PREOONIC BACKEND - ENVIRONMENT CONFIG           ║
# ║               Copy this file to .env and fill             ║
# ║                                                           ║
# ║  🟢 Required : Bắt buộc phải có để chạy project          ║
# ║  🟡 Optional : Không bắt buộc, có thể để sau             ║
# ║  🔵 Future   : Cho tính năng tương lai                   ║
# ╚═══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# 🟢 SERVER
# ═══════════════════════════════════════════════════════════
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# ═══════════════════════════════════════════════════════════
# 🟢 SQL SERVER ()
# ═══════════════════════════════════════════════════════════
# Database
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=preonic_v2
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# Đặt true nếu kết nối Azure SQL hoặc SQL Server dùng SSL
DB_ENCRYPT=false

# Đặt true khi dùng self-signed certificate (môi trường local/dev)
DB_TRUST_SERVER_CERTIFICATE=true

# TypeORM tự đồng bộ schema (chỉ dùng development — production dùng migration)
DB_SYNCHRONIZE=false

# Bật log query SQL khi debug (development only)
DB_LOGGING=false

# ═══════════════════════════════════════════════════════════
# 🟢 JWT
# ═══════════════════════════════════════════════════════════
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_SECRET_KEY
JWT_REFRESH_EXPIRE=30d

# ═══════════════════════════════════════════════════════════
# 🟢 SECURITY (khớp với logic trong User entity)
# ═══════════════════════════════════════════════════════════
PASSWORD_RESET_EXPIRE=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ═══════════════════════════════════════════════════════════
# 🟢 CORS
# ═══════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:3000
# Thêm nhiều URL nếu cần (preview Vercel, staging...)
# FRONTEND_URLS=https://preview-1.vercel.app,https://preview-2.vercel.app
# Backend chạy sau reverse proxy (Render/Railway/Fly/Azure...) nên đặt 1 để
# rate-limit đọc đúng IP người dùng.
# TRUST_PROXY=1

# Nếu frontend Vercel và backend khác site, refresh cookie cần hai dòng sau.
# AUTH_COOKIE_SAME_SITE=none
# AUTH_COOKIE_SECURE=true
# Nếu dùng cùng parent domain (app.preonic.vn/api.preonic.vn), có thể đặt:
# AUTH_COOKIE_DOMAIN=.preonic.vn

# ═══════════════════════════════════════════════════════════
# 🟡 EMAIL (SMTP) — cần cho forgot password, verify email
# ═══════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=PreOnic Platform
# SMTP_FROM_EMAIL=noreply@preoonic.com

# ═══════════════════════════════════════════════════════════
# 🟢 FILE UPLOAD (Cloudinary) — bắt buộc để upload ảnh SP/avatar/dispute
# Lấy tại: https://console.cloudinary.com/ → Dashboard
# ═══════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# MAX_FILE_SIZE=5242880
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ═══════════════════════════════════════════════════════════
# 🔵 WEATHER API
# ═══════════════════════════════════════════════════════════
# WEATHER_API_KEY=

# ═══════════════════════════════════════════════════════════
# 🔵 OAUTH
# ═══════════════════════════════════════════════════════════
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ═══════════════════════════════════════════════════════════
# 🟢 DIRECT GOODS PAYMENT + PLATFORM FEE BILLING
# ═══════════════════════════════════════════════════════════
# Hai khóa độc lập, base64. Tạo từng khóa bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_BANK_DATA_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
PAYMENT_BANK_DATA_HMAC_KEY=replace_with_another_32_random_bytes_in_base64
PAYMENT_BANK_DATA_ACTIVE_KEY_VERSION=1

# QR chuyển tiền hàng trực tiếp từ doanh nghiệp đến nông dân.
DIRECT_PAYMENT_QR_BASE_URL=https://vietqr.app/img
# Mỗi lần mở/tạo lại QR, phiên thanh toán tiền hàng có hiệu lực 10 phút.
DIRECT_PAYMENT_QR_TTL_MINUTES=10
# Một webhook SePay có thể nhận cả tiền hàng và phí qua endpoint:
# POST /api/v1/billing/webhooks/sepay. Backend phân luồng bằng mã PRN.../PRNFE...
SEPAY_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Nếu webhook trên SePay đang chọn API Key thay vì HMAC, đặt cùng khóa ở đây.
# Backend tự nhận diện phương thức qua header, nhưng luôn xác minh đúng khóa.
# SEPAY_WEBHOOK_API_KEY=replace_with_at_least_32_random_characters
# Bearer token API v2 dùng làm đường đối soát dự phòng khi webhook giao thất bại.
# Có thể dùng cùng token với BANK_ACCOUNT_VERIFICATION_API_KEY.
# SEPAY_API_TOKEN=replace_with_sepay_api_v2_bearer_token
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
# Biến riêng phía dưới chỉ cần khi cố ý tách webhook tiền hàng khỏi webhook phí.
# DIRECT_PAYMENT_BANK_WEBHOOK_SECRET=replace_with_a_different_32_character_secret
DIRECT_PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# Chỉ bật tạm thời khi test luồng cũ không có webhook. Production phải để false.
DIRECT_PAYMENT_ALLOW_MANUAL_CONFIRMATION=false

# Mức phí mặc định được seed trong PlatformFeePolicies là 0.5% cho doanh nghiệp
# và 0.3% cho nông dân. Không cấu hình CONTRACT_PAYMENT_FLOW: hợp đồng mới luôn
# dùng direct_v2 và không có cờ môi trường để bật lại luồng thanh toán cũ.

# Local/test có thể dùng mock. Production mặc định dùng bank_transfer.
FEE_PAYMENT_PROVIDER=bank_transfer
FEE_PAYMENT_BANK_ACCOUNT_NUMBER=replace_with_platform_account_number
FEE_PAYMENT_BANK_CODE=replace_with_bank_code
FEE_PAYMENT_BANK_ACCOUNT_HOLDER=PREONIC
FEE_PAYMENT_QR_BASE_URL=https://vietqr.app/img
# Mã QR hết hiệu lực sau 10 phút. Có thể đặt từ 5 đến 60 phút.
FEE_PAYMENT_QR_TTL_MINUTES=10
# Secret phải trùng với HMAC-SHA256 Secret Key cấu hình trên SePay. Webhook SePay
# gửi X-SePay-Signature=sha256=<digest> và X-SePay-Timestamp=<unix-seconds>.
FEE_PAYMENT_BANK_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Chỉ dùng khi FEE_PAYMENT_PROVIDER=mock ở local/test.
FEE_PAYMENT_MOCK_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
FEE_PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
FEE_STATEMENT_DUE_DAYS=10
FEE_RESTRICTION_GRACE_DAYS=3
FEE_PAYMENT_UNINITIALIZED_TTL_MINUTES=30

# Xác minh tài khoản nhận tiền qua Bank Hub/provider của bạn. Endpoint HTTPS
# nhận { bankCode, accountNumber } và trả { valid, accountHolder, reference }.
# Khi lưu, tài khoản luôn chờ admin duyệt. Sau khi admin duyệt, SePay API mới
# được phép đối chiếu tài khoản liên kết và chuyển trạng thái thành verified.
# Generic lookup provider: POST { bankCode, accountNumber }.
# BANK_ACCOUNT_VERIFICATION_URL=https://bank-provider.example.com/v1/accounts/verify
# BANK_ACCOUNT_VERIFICATION_API_KEY=replace_with_provider_secret
# BANK_ACCOUNT_VERIFICATION_PROVIDER=bank_hub
#
# SePay API v2 mode only verifies bank accounts already linked to your SePay company.
# The API Token is created under SePay "API Access" and is NOT the webhook API key.
# BANK_ACCOUNT_VERIFICATION_PROVIDER=sepay_api_v2
# BANK_ACCOUNT_VERIFICATION_URL=https://userapi.sepay.vn/v2/bank-accounts
# BANK_ACCOUNT_VERIFICATION_API_KEY=replace_with_sepay_api_v2_token
# Trang SePay để nông dân tự liên kết tài khoản. Không dùng URL trung gian.
# SEPAY_BANK_LINK_URL=https://my.sepay.vn/bankaccount
BANK_ACCOUNT_VERIFICATION_REQUIRED=false
BANK_ACCOUNT_VERIFICATION_TIMEOUT_MS=8000
BANK_ACCOUNT_VERIFICATION_LIMIT_PER_15_MIN=20

# PreOnic AI (Responses API)
# OPENAI_API_KEY=
OPENAI_PUBLIC_AI_MODEL=gpt-4o-mini
OPENAI_FARMER_AI_MODEL=gpt-4o-mini
OPENAI_ENTERPRISE_AI_MODEL=gpt-4o-mini
OPENAI_PUBLIC_AI_MAX_OUTPUT_TOKENS=400
FARMER_AI_LIMIT_PER_15_MIN=50
ENTERPRISE_AI_LIMIT_PER_15_MIN=50

# ╔═══════════════════════════════════════════════════════════╗
# ║           PREOONIC BACKEND - ENVIRONMENT CONFIG           ║
# ║               Copy this file to .env and fill             ║
# ║                                                           ║
# ║  🟢 Required : Bắt buộc phải có để chạy project          ║
# ║  🟡 Optional : Không bắt buộc, có thể để sau             ║
# ║  🔵 Future   : Cho tính năng tương lai                   ║
# ╚═══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# 🟢 SERVER
# ═══════════════════════════════════════════════════════════
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1

# ═══════════════════════════════════════════════════════════
# 🟢 SQL SERVER ()
# ═══════════════════════════════════════════════════════════
# Database
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=preonic
DB_USERNAME=sa
DB_PASSWORD=your_password_here

# Đặt true nếu kết nối Azure SQL hoặc SQL Server dùng SSL
DB_ENCRYPT=false

# Đặt true khi dùng self-signed certificate (môi trường local/dev)
DB_TRUST_SERVER_CERTIFICATE=true

# TypeORM tự đồng bộ schema (chỉ dùng development — production dùng migration)
DB_SYNCHRONIZE=false

# Bật log query SQL khi debug (development only)
DB_LOGGING=false

# ═══════════════════════════════════════════════════════════
# 🟢 JWT
# ═══════════════════════════════════════════════════════════
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_SECRET_KEY
JWT_REFRESH_EXPIRE=30d

# ═══════════════════════════════════════════════════════════
# 🟢 SECURITY (khớp với logic trong User entity)
# ═══════════════════════════════════════════════════════════
PASSWORD_RESET_EXPIRE=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15

# ═══════════════════════════════════════════════════════════
# 🟢 CORS
# ═══════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:3000
# Thêm nhiều URL nếu cần (preview Vercel, staging...)
# FRONTEND_URLS=https://preview-1.vercel.app,https://preview-2.vercel.app

# ═══════════════════════════════════════════════════════════
# 🟡 EMAIL (SMTP) — cần cho forgot password, verify email
# ═══════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_NAME=PreOnic Platform
# SMTP_FROM_EMAIL=noreply@preoonic.com

# ═══════════════════════════════════════════════════════════
# 🟡 FILE UPLOAD
# ═══════════════════════════════════════════════════════════
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ═══════════════════════════════════════════════════════════
# 🔵 WEATHER API
# ═══════════════════════════════════════════════════════════
# WEATHER_API_KEY=

# ═══════════════════════════════════════════════════════════
# 🔵 PAYMENT
# ═══════════════════════════════════════════════════════════
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# ═══════════════════════════════════════════════════════════
# 🔵 OAUTH
# ═══════════════════════════════════════════════════════════
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ═══════════════════════════════════════════════════════════
# 🔵 BUSINESS SETTINGS
# ═══════════════════════════════════════════════════════════
# PLATFORM_COMMISSION_RATE=3
# CONTRACT_DEPOSIT_PERCENTAGE=20

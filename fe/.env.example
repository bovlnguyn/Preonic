# ╔═══════════════════════════════════════════════════════════╗
# ║            PREOONIC FRONTEND - ENVIRONMENT CONFIG         ║
# ║               Copy this file to .env and fill             ║
# ╚═══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# 🟢 Required
# ═══════════════════════════════════════════════════════════

# URL của Backend API — khớp với PORT trong be/.env
REACT_APP_API_URL=http://localhost:5000/api/v1

# Port cho React dev server
PORT=8000

# ═══════════════════════════════════════════════════════════
# 🔵 Future
# ═══════════════════════════════════════════════════════════
# REACT_APP_GOOGLE_CLIENT_ID=
# REACT_APP_MAPS_API_KEY=
